{
  "name": "alirezabelal/travel-tour-reservation-bot",
  "description": "Self-hosted Persian Telegram tour reservations with atomic group capacity, administrator review and durable notifications.",
  "type": "project",
  "license": "GPL-3.0-only",
  "require": {
    "php": "^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "catfan/medoo": "^2.1",
    "vlucas/phpdotenv": "^5.6",
    "ext-pdo_mysql": "*"
  },
  "config": {
    "platform": {
      "php": "8.0.30"
    },
    "sort-packages": true
  },
  "scripts": {
    "test:unit": [
      "@php tests/validators_test.php",
      "@php tests/webhook_test.php",
      "@php tests/incoming_update_test.php",
      "@php tests/booking_unit_test.php",
      "@php tests/architecture_test.php",
      "@php tests/catalogue_architecture_test.php",
      "@php tests/payment_rules_test.php",
      "@php tests/application_architecture_test.php",
      "@php tests/tour_rules_test.php",
      "@php tests/http_ingress_test.php",
      "@php tests/legacy_responder_test.php",
      "@php tests/transaction_cleanup_test.php",
      "@php tests/compatibility_loaders_test.php",
      "@php tests/transaction_retry_test.php"
    ],
    "test:integration": [
      "@php tests/mysql_test.php",
      "@php tests/workflow_test.php",
      "@php tests/product_test.php",
      "@php tests/operations_test.php",
      "@php tests/product_workflow_test.php",
      "@php tests/catalogue_characterization_test.php",
      "@php tests/manual_payment_test.php",
      "@php tests/product_query_test.php",
      "@php tests/tour_service_test.php",
      "@php tests/booking_use_case_test.php",
      "@php tests/worker_process_test.php",
      "@php tests/legacy_rendering_test.php"
    ],
    "analyse": "@php tools/quality/vendor/bin/phpstan analyse -c phpstan.neon --no-progress",
    "lint:style": "@php tools/quality/vendor/bin/phpcs --standard=.phpcs.xml"
  }
}
