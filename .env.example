# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_IDS=123456789

# Required: 32-256 characters (A-Z, a-z, 0-9, underscore, hyphen).
# Generate with: openssl rand -hex 32; register the same value with Telegram.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_64_character_hex_secret

# Identity fields for operators requiring verified Iranian contacts.
# Generate locally: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Keep this key safe and backed up separately; losing it makes stored profiles unreadable.
PROFILE_ENCRYPTION_KEY=
# true requires Telegram-shared phone and valid national code before booking.
# Default false for safe upgrades of existing installations.
REQUIRE_VERIFIED_PROFILE=false

# MySQL / MariaDB
DB_SERVER=localhost
DB_PORT=3306
DB_DATABASE=travel_tour_bot
DB_USERNAME=travel_tour_bot
DB_PASSWORD=replace_with_a_strong_password

# Docker Compose only; use a distinct strong password.
DB_ROOT_PASSWORD=replace_with_a_different_strong_password

# Display timezone (database timestamps are UTC)
APP_TIMEZONE=Asia/Tehran
# Inactive profiles without active bookings are anonymized after 30-3650 days
# Enable automatic profile anonymization only after approving a retention policy.
RETENTION_ENABLED=false
RETENTION_DAYS=180
# Local payment simulator only. Keep disabled outside disposable testing.
PAYMENT_SANDBOX_ENABLED=false
PAYMENT_SANDBOX_SECRET=replace_with_a_distinct_random_64_character_secret

# Optional demo seed requires development/test AND an explicit --confirm argument
APP_ENV=production
